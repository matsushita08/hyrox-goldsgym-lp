{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HYROX AI開発社員 ローカルIssueタスク v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "issue", "priority", "description", "allowedPaths", "acceptanceCriteria", "budget"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "number", "title", "url"],
      "properties": {
        "repository": { "const": "matsushita08/hyrox-goldsgym-lp" },
        "number": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "type": "string", "pattern": "^https://github\\.com/matsushita08/hyrox-goldsgym-lp/issues/[1-9][0-9]*$" }
      }
    },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "allowedPaths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["index.html", "style.css", "script.js", "leaflet-fallback.css"] }
    },
    "acceptanceCriteria": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "path", "value"],
            "properties": {
              "id": { "$ref": "#/$defs/criterionId" },
              "kind": { "enum": ["file_contains", "file_not_contains"] },
              "path": { "$ref": "#/$defs/sitePath" },
              "value": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "path"],
            "properties": {
              "id": { "$ref": "#/$defs/criterionId" },
              "kind": { "const": "js_syntax" },
              "path": { "const": "script.js" }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "description"],
            "properties": {
              "id": { "$ref": "#/$defs/criterionId" },
              "kind": { "const": "manual" },
              "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        ]
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["maxSeconds", "maxUsd"],
      "properties": {
        "maxSeconds": { "type": "number", "minimum": 0.01, "maximum": 120 },
        "maxUsd": { "type": "number", "minimum": 0, "maximum": 0 }
      }
    }
  },
  "$defs": {
    "criterionId": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "sitePath": { "enum": ["index.html", "style.css", "script.js", "leaflet-fallback.css"] }
  },
  "$comment": "NodeのvalidateTaskが追加でIssue番号とURLの一致、完了条件IDの一意性、タスク許可パスへの包含、秘密らしい入力の拒否、空白だけの文字列拒否を検証する。外部JSON Schema実行依存なし。"
}
